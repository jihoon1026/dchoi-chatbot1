# ===== 챗봇 비밀 설정 파일 (예시 파일 - 실제 값은 .env 에) =====

# 1) Anthropic API 키: https://platform.claude.com 에서 발급받아 = 뒤에 붙여넣으세요
ANTHROPIC_API_KEY=

# 2) 관리자 페이지(/admin) 비밀번호: 원하는 비밀번호로 바꿔도 됩니다
ADMIN_PASSWORD=

# 3) 로그인 쿠키 보호용 비밀값 (아무 긴 랜덤 문자열)
SESSION_SECRET=

# (선택) 사용할 모델 - 비워두면 claude-sonnet-5-5
CHAT_MODEL=claude-sonnet-5-5
ANALYSIS_MODEL=claude-sonnet-5-5

# (Vercel 전용) Upstash Redis 를 연결하면 Vercel 이 자동으로 채워줍니다. 내 컴퓨터에서는 비워두세요.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
